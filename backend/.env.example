# Copy to backend/.env and fill in.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Your database connection URL, e.g.
#   postgres://USER:PASSWORD@HOST:5432/DBNAME
# Leave empty in development to use a local SQLite file.
DATABASE_URL=
# Set to true for hosted Postgres that requires TLS (Neon, Supabase, Render…)
DB_SSL_REQUIRE=false
